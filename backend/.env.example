# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=4000

# Local Postgres, or your Neon / Supabase connection string.
DATABASE_URL=postgres://skillpass:skillpass@localhost:5432/skillpass
# Set to true for hosted databases that require SSL (Neon, Supabase, Render Postgres).
DATABASE_SSL=false

# Both must be at least 32 characters and different from each other. The server refuses to start
# while they still contain the placeholder text below. Generate each one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-1
SIGNING_KEY=change-me-to-a-different-long-random-string-2

JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Comma-separated list of frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:5173

# Where uploaded evidence is stored (local disk). On Render use a persistent disk or switch to cloud storage.
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=40
# Evidence files are only served through signed links; this is how long each link stays valid.
EVIDENCE_URL_MINUTES=30
# Demo build only: accept generated sample evidence (marked source=demo). Never switch this on with real participants.
ALLOW_DEMO_EVIDENCE=false
# Public base URL of this API, used to build evidence links.
PUBLIC_URL=http://localhost:4000
# Where people open the app (the frontend). Used in email links. Defaults to the first CORS origin.
APP_URL=http://localhost:5173

# Texts (phone verification and notifications). "console" prints them in this terminal and, outside production,
# shows phone codes on screen so you can demo without a real SMS account.
SMS_PROVIDER=console
# For SMS_PROVIDER=termii: the base URL, API key and an approved sender ID from your Termii dashboard.
# Use the "dnd" channel to reach numbers on Do-Not-Disturb (needs a sender ID the networks have approved).
TERMII_BASE_URL=
TERMII_API_KEY=
TERMII_SENDER_ID=
TERMII_CHANNEL=dnd

# Emails (address confirmation and password reset). "console" prints them here and shows links on screen.
EMAIL_PROVIDER=console
# For EMAIL_PROVIDER=resend:
RESEND_API_KEY=
EMAIL_FROM=SkillPass <no-reply@your-domain.com>
