# Copy to .env.local for local development. Vite only exposes variables that start with VITE_.

# Where the SkillPass API runs (see backend/README.md).
VITE_API_URL=http://localhost:4000

# Demo build only: shows quick-login buttons and "demo capture" evidence for people without a camera.
# Leave this false (or unset) for a real pilot. The API must also set ALLOW_DEMO_EVIDENCE=true for demo evidence to be accepted.
VITE_DEMO_MODE=false
